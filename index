  <!-- ==================== JAVASCRIPT LOGIC ==================== -->
  <script>
    // =========================================================================
    // 1. KHỞI TẠO SUPABASE CLIENT & STATE TOÀN CỤC
    // =========================================================================
    // Anh có thể điền cứng URL và Anon Key ở 2 dòng dưới đây để khỏi phải nhập tay trên trình duyệt:
    const DEFAULT_SUPABASE_URL = "";
    const DEFAULT_SUPABASE_ANON_KEY = "";

    let supabaseClient = null;
    let activeTab = 'reconcile';

    // Cache dữ liệu trong phiên làm việc
    let state = {
      salesReps: [],
      productGroups: [],
      skuMappings: [],
      availableMonths: [],
      reconcileRows: [],
      kvCustomers: [],
      dmsOutlets: [],
      customerLinks: [],
      suggestions: [],
      kvLinesMonth: [],
      dmsLinesMonth: [],
      kvLines3M: [],
      dmsLines3M: []
    };

    document.addEventListener('DOMContentLoaded', () => {
      lucide.createIcons();
      initSupabase();
    });

    function initSupabase() {
      const url = localStorage.getItem('sb_url') || DEFAULT_SUPABASE_URL;
      const key = localStorage.getItem('sb_key') || DEFAULT_SUPABASE_ANON_KEY;

      if (url && key) {
        document.getElementById('cfgSupabaseUrl').value = url;
        document.getElementById('cfgSupabaseKey').value = key;
        supabaseClient = window.supabase.createClient(url, key);
        updateDbStatus(true);
        refreshAllData();
      } else {
        updateDbStatus(false);
        openConfigModal();
      }
    }

    function updateDbStatus(connected) {
      const badge = document.getElementById('dbStatusBadge');
      if (connected) {
        badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-400"></span> Đã kết nối Supabase`;
      } else {
        badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-amber-400"></span> Chưa kết nối Supabase`;
      }
    }

    function saveSupabaseConfig() {
      const url = document.getElementById('cfgSupabaseUrl').value.trim();
      const key = document.getElementById('cfgSupabaseKey').value.trim();
      if (!url || !key) return alert('Vui lòng nhập đầy đủ Project URL và Anon Key!');
      localStorage.setItem('sb_url', url);
      localStorage.setItem('sb_key', key);
      closeModal('configModal');
      initSupabase();
    }

    function openConfigModal() { document.getElementById('configModal').classList.remove('hidden'); }
    function openUploadModal() { document.getElementById('uploadModal').classList.remove('hidden'); }
    function closeModal(id) { document.getElementById(id).classList.add('hidden'); }

    // =========================================================================
    // 2. TẢI DỮ LIỆU TỪ SUPABASE & BỘ LỌC
    // =========================================================================
    async function refreshAllData() {
      if (!supabaseClient) return;

      // 1. Tải danh mục Sale, Nhóm SP, SKU Mappings
      const [resReps, resGroups, resMaps] = await Promise.all([
        supabaseClient.from('sales_reps').select('*').order('full_name'),
        supabaseClient.from('product_groups').select('*').order('display_order'),
        supabaseClient.from('sku_mappings').select('*')
      ]);

      state.salesReps = resReps.data || [];
      state.productGroups = resGroups.data || [];
      state.skuMappings = resMaps.data || [];

      // Kiểm tra mã SKU mới chưa gán nhóm
      const unmapped = state.skuMappings.filter(m => !m.product_group_id);
      const alertBox = document.getElementById('unmappedAlert');
      if (unmapped.length > 0) {
        alertBox.classList.remove('hidden');
        document.getElementById('unmappedText').innerText =
          `Có ${unmapped.length} mã mới (${unmapped.map(u => u.raw_code).join(', ')}) chưa được phân nhóm nên chưa cộng vào bảng đối chiếu.`;
      } else {
        alertBox.classList.add('hidden');
      }

      // Populate dropdown Sale
      const repSelect = document.getElementById('filterSalesRep');
      const currentRep = repSelect.value;
      repSelect.innerHTML = `<option value="ALL">Tất cả 5 Sale (Team BC)</option>` +
        state.salesReps.map(r => `<option value="${r.id}">${r.full_name}</option>`).join('');
      if ([...repSelect.options].some(o => o.value === currentRep)) repSelect.value = currentRep;

      // 2. Lấy danh sách các tháng đang có dữ liệu
      const [mKv, mDms] = await Promise.all([
        supabaseClient.from('kv_sales_lines').select('sale_month'),
        supabaseClient.from('dms_order_lines').select('order_month')
      ]);
      const monthSet = new Set([
        ...(mKv.data || []).map(x => x.sale_month),
        ...(mDms.data || []).map(x => x.order_month)
      ]);
      state.availableMonths = Array.from(monthSet).sort().reverse();

      const monthSelect = document.getElementById('filterMonth');
      const currentMonth = monthSelect.value;
      if (state.availableMonths.length === 0) {
        monthSelect.innerHTML = `<option value="">-- Chưa có dữ liệu --</option>`;
      } else {
        monthSelect.innerHTML = state.availableMonths.map(m => {
          const [y, mm] = m.split('-');
          return `<option value="${m}">Tháng ${mm}/${y}</option>`;
        }).join('');
        if (state.availableMonths.includes(currentMonth)) monthSelect.value = currentMonth;
      }

      await onFilterChange();
    }

    async function onFilterChange() {
      if (!supabaseClient) return;
      const selectedMonth = document.getElementById('filterMonth').value;
      const selectedRep = document.getElementById('filterSalesRep').value;
      if (!selectedMonth) return;

      // Tính mốc 3 tháng gần nhất tính đến tháng đang chọn (để xem lịch sử 3 tháng của từng KH)
      const dt = new Date(selectedMonth + 'T00:00:00');
      dt.setMonth(dt.getMonth() - 2);
      const threeMonthsAgo = dt.toISOString().slice(0, 10);

      // Query song song: View đối chiếu, KV lines tháng chọn, DMS lines tháng chọn, dữ liệu 3 tháng, KH & Links
      let qReconcile = supabaseClient.from('v_monthly_reconciliation').select('*').eq('month_date', selectedMonth);
      let qKvMonth = supabaseClient.from('kv_sales_lines').select('*').eq('sale_month', selectedMonth);
      let qDmsMonth = supabaseClient.from('dms_order_lines').select('*').eq('order_month', selectedMonth).eq('dis_code', 'CD1084');
      let qKv3M = supabaseClient.from('kv_sales_lines').select('*').gte('sale_month', threeMonthsAgo).lte('sale_month', selectedMonth);
      let qDms3M = supabaseClient.from('dms_order_lines').select('*').gte('order_month', threeMonthsAgo).lte('order_month', selectedMonth).eq('dis_code', 'CD1084');

      if (selectedRep !== 'ALL') {
        qReconcile = qReconcile.eq('sales_rep_id', selectedRep);
        qKvMonth = qKvMonth.eq('sales_rep_id', selectedRep);
        qDmsMonth = qDmsMonth.eq('sales_rep_id', selectedRep);
        qKv3M = qKv3M.eq('sales_rep_id', selectedRep);
        qDms3M = qDms3M.eq('sales_rep_id', selectedRep);
      }

      const [resRec, resKvM, resDmsM, resKv3M, resDms3M, resKvC, resDmsO, resLinks, resSug] = await Promise.all([
        qReconcile,
        qKvMonth,
        qDmsMonth,
        qKv3M,
        qDms3M,
        supabaseClient.from('kv_customers').select('*'),
        supabaseClient.from('dms_outlets').select('*'),
        supabaseClient.from('customer_links').select('*'),
        supabaseClient.from('v_customer_match_suggestions').select('*').order('similarity_score', { ascending: false }).limit(50)
      ]);

      state.reconcileRows = resRec.data || [];
      state.kvLinesMonth = resKvM.data || [];
      state.dmsLinesMonth = resDmsM.data || [];
      state.kvLines3M = resKv3M.data || [];
      state.dmsLines3M = resDms3M.data || [];
      state.kvCustomers = resKvC.data || [];
      state.dmsOutlets = resDmsO.data || [];
      state.customerLinks = resLinks.data || [];
      state.suggestions = resSug.data || [];

      renderActiveTab();
    }

    function switchTab(tabName) {
      activeTab = tabName;
      ['reconcile', 'kv', 'dms', 'custMatch', 'promo'].forEach(t => {
        document.getElementById(`view-${t}`).classList.toggle('hidden', t !== tabName);
        const btn = document.getElementById(`tabBtn-${t}`);
        btn.className = `py-3 text-sm whitespace-nowrap flex items-center gap-2 ${t === tabName ? 'tab-active' : 'tab-inactive'}`;
      });
      renderActiveTab();
    }

    function renderActiveTab() {
      if (activeTab === 'reconcile') renderReconcileTab();
      if (activeTab === 'kv') renderKvCustomersTab();
      if (activeTab === 'dms') renderDmsCustomersTab();
      if (activeTab === 'custMatch') renderCustomerMatchTab();
      if (activeTab === 'promo') renderPromoTab();
      lucide.createIcons();
    }

    // =========================================================================
    // 3. RENDER TAB 1: ĐỐI CHIẾU SẢN LƯỢNG & LŨY KẾ
    // =========================================================================
    function renderReconcileTab() {
      const brandFilter = document.getElementById('filterBrand').value;
      // Gom nhóm theo product_group_id (vì nếu chọn ALL sale thì mỗi SKU có 5 dòng của 5 sale)
      const groupedMap = new Map();

      state.reconcileRows.forEach(r => {
        if (brandFilter !== 'ALL' && r.brand !== brandFilter) return;
        if (!groupedMap.has(r.product_group_id)) {
          groupedMap.set(r.product_group_id, {
            product_group_id: r.product_group_id,
            brand: r.brand,
            group_name: r.group_name,
            display_order: r.display_order,
            kv_paid_qty: 0,
            kv_free_qty: 0,
            dms_order_qty: 0,
            prev_cumulative_diff: 0,
            monthly_diff: 0,
            total_cumulative_diff: 0
          });
        }
        const item = groupedMap.get(r.product_group_id);
        item.kv_paid_qty += Number(r.kv_paid_qty || 0);
        item.kv_free_qty += Number(r.kv_free_qty || 0);
        item.dms_order_qty += Number(r.dms_order_qty || 0);
        item.prev_cumulative_diff += Number(r.prev_cumulative_diff || 0);
        item.monthly_diff += Number(r.monthly_diff || 0);
        item.total_cumulative_diff += Number(r.total_cumulative_diff || 0);
      });

      const rows = Array.from(groupedMap.values()).sort((a, b) => a.display_order - b.display_order);

      let totKvPaid = 0, totKvFree = 0, totDms = 0, totPrev = 0, totMonth = 0, totCum = 0;
      const tbody = document.getElementById('reconcileTableBody');

      if (rows.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8" class="px-4 py-8 text-center text-slate-400">Không có phát sinh sản lượng cho bộ lọc này.</td></tr>`;
        document.getElementById('reconcileTableFoot').innerHTML = '';
      } else {
        tbody.innerHTML = rows.map(r => {
          totKvPaid += r.kv_paid_qty;
          totKvFree += r.kv_free_qty;
          totDms += r.dms_order_qty;
          totPrev += r.prev_cumulative_diff;
          totMonth += r.monthly_diff;
          totCum += r.total_cumulative_diff;

          return `
            <tr class="hover:bg-slate-50 transition">
              <td class="px-4 py-3 font-semibold text-slate-700">${r.brand}</td>
              <td class="px-4 py-3 font-medium text-slate-900">${r.group_name}</td>
              <td class="px-4 py-3 text-right font-semibold">${fmtNum(r.kv_paid_qty)}</td>
              <td class="px-4 py-3 text-right font-semibold text-emerald-700">${fmtNum(r.dms_order_qty)}</td>
              <td class="px-4 py-3 text-right bg-slate-50/80 ${diffColor(r.prev_cumulative_diff)}">${fmtDiff(r.prev_cumulative_diff)}</td>
              <td class="px-4 py-3 text-right font-semibold ${diffColor(r.monthly_diff)}">${fmtDiff(r.monthly_diff)}</td>
              <td class="px-4 py-3 text-right font-bold bg-emerald-50/40 ${diffColor(r.total_cumulative_diff)}">${fmtDiff(r.total_cumulative_diff)}</td>
              <td class="px-4 py-3 text-right text-amber-700 font-medium">${r.kv_free_qty > 0 ? fmtNum(r.kv_free_qty) : '-'}</td>
            </tr>
          `;
        }).join('');

        document.getElementById('reconcileTableFoot').innerHTML = `
          <tr>
            <td colspan="2" class="px-4 py-3 uppercase text-xs">Tổng Cộng Toàn Bộ</td>
            <td class="px-4 py-3 text-right">${fmtNum(totKvPaid)}</td>
            <td class="px-4 py-3 text-right text-emerald-800">${fmtNum(totDms)}</td>
            <td class="px-4 py-3 text-right ${diffColor(totPrev)}">${fmtDiff(totPrev)}</td>
            <td class="px-4 py-3 text-right ${diffColor(totMonth)}">${fmtDiff(totMonth)}</td>
            <td class="px-4 py-3 text-right text-base ${diffColor(totCum)}">${fmtDiff(totCum)}</td>
            <td class="px-4 py-3 text-right text-amber-800">${fmtNum(totKvFree)}</td>
          </tr>
        `;
      }

      // Cập nhật 5 thẻ KPI
      document.getElementById('kpi-kvPaid').innerText = fmtNum(totKvPaid);
      document.getElementById('kpi-dmsOrder').innerText = fmtNum(totDms);
      document.getElementById('kpi-prevDiff').innerText = fmtDiff(totPrev);
      document.getElementById('kpi-prevDiff').className = `text-2xl font-bold mt-1 ${diffColor(totPrev)}`;
      document.getElementById('kpi-monthDiff').innerText = fmtDiff(totMonth);
      document.getElementById('kpi-monthDiff').className = `text-2xl font-bold mt-1 ${diffColor(totMonth)}`;
      document.getElementById('kpi-totalDiff').innerText = fmtDiff(totCum);
      document.getElementById('kpi-totalLabel').innerText =
        totCum < 0 ? `Còn thiếu ${fmtNum(Math.abs(totCum))} két/thùng chưa key DMS`
        : totCum > 0 ? `Đang key dư ${fmtNum(totCum)} két/thùng trên DMS`
        : 'Đã khớp 100% số liệu';
    }

    // =========================================================================
    // 4. RENDER TAB 2: KHÁCH HÀNG KIOTVIET (Ẩn SKU, bấm để xổ chi tiết)
    // =========================================================================
    function renderKvCustomersTab() {
      const kw = document.getElementById('searchKvCust').value.toLowerCase().trim();
      const custMap = new Map(state.kvCustomers.map(c => [c.kv_customer_code, c]));
      const repMap = new Map(state.salesReps.map(r => [r.id, r.full_name]));

      // Gom đơn tháng chọn theo khách hàng
      const agg = new Map();
      state.kvLinesMonth.forEach(line => {
        if (!agg.has(line.kv_customer_code)) {
          agg.set(line.kv_customer_code, { paid: 0, free: 0, rev: 0, lines: [] });
        }
        const entry = agg.get(line.kv_customer_code);
        if (line.is_free_gift) entry.free += Number(line.quantity);
        else entry.paid += Number(line.quantity);
        entry.rev += Number(line.total_amount);
        entry.lines.push(line);
      });

      const list = Array.from(agg.entries()).filter(([code]) => {
        const c = custMap.get(code) || {};
        return !kw || code.toLowerCase().includes(kw) || (c.kv_customer_name || '').toLowerCase().includes(kw) || (c.phone || '').includes(kw);
      }).sort((a, b) => b[1].paid - a[1].paid);

      const container = document.getElementById('kvCustomersList');
      if (list.length === 0) {
        container.innerHTML = `<div class="bg-white p-8 rounded-xl border text-center text-slate-400 text-sm">Không tìm thấy khách hàng KiotViet phát sinh trong tháng này.</div>`;
        return;
      }

      container.innerHTML = list.map(([code, data]) => {
        const c = custMap.get(code) || { kv_customer_name: code };
        const repName = repMap.get(c.sales_rep_id) || 'Chưa gán sale';
        // Lấy thêm lịch sử 3 tháng của KH này
        const hist3M = state.kvLines3M.filter(l => l.kv_customer_code === code);
        const histByMonth = {};
        hist3M.forEach(h => {
          const m = h.sale_month.slice(0, 7);
          if (!histByMonth[m]) histByMonth[m] = {};
          const key = `${h.raw_product_name} ${h.is_free_gift ? '(0đ)' : ''}`;
          histByMonth[m][key] = (histByMonth[m][key] || 0) + Number(h.quantity);
        });

        return `
          <div class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden">
            <button onclick="toggleAccordion('kv-det-${code}')" class="w-full px-5 py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-left hover:bg-slate-50 transition">
              <div>
                <div class="flex items-center gap-2">
