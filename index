<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Đối Chiếu Sale KiotViet & DMS | Carlsberg Team BC</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- SheetJS (XLSX) để đọc file Excel KiotViet & DMS trực tiếp trên trình duyệt -->
  <script src="https://cdn.sheetjs.com/xlsx-0.20.2/package/dist/xlsx.full.min.js"></script>
  <!-- Supabase JS v2 -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
    body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
    .tab-active { border-bottom: 2px solid #047857; color: #047857; font-weight: 600; }
    .tab-inactive { color: #64748b; }
    .tab-inactive:hover { color: #0f172a; }
    /* Custom scrollbar */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #f1f5f9; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
  </style>
</head>
<body class="text-slate-800 antialiased">

  <!-- TOP HEADER -->
  <header class="bg-emerald-900 text-white shadow-md sticky top-0 z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="bg-emerald-700 p-2 rounded-lg">
          <i data-lucide="scale" class="w-6 h-6 text-emerald-200"></i>
        </div>
        <div>
          <h1 class="font-bold text-lg tracking-tight leading-tight">CARLSBERG • ĐỐI CHIẾU SALE THÔNG MINH</h1>
          <p class="text-xs text-emerald-300">KiotViet vs DMS (NPP Viet Bill • Team Bến Cát)</p>
        </div>
      </div>

      <div class="flex items-center gap-2 sm:gap-3">
        <span id="dbStatusBadge" class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-800 text-emerald-200">
          <span class="w-2 h-2 rounded-full bg-amber-400"></span> Chưa kết nối Supabase
        </span>
        <button onclick="openUploadModal()" class="inline-flex items-center gap-1.5 bg-amber-500 hover:bg-amber-600 text-slate-950 font-semibold text-xs sm:text-sm px-3.5 py-2 rounded-lg shadow transition">
          <i data-lucide="upload-cloud" class="w-4 h-4"></i>
          <span>Tải File Excel</span>
        </button>
        <button onclick="openConfigModal()" class="p-2 rounded-lg bg-emerald-800 hover:bg-emerald-700 text-emerald-100 transition" title="Cấu hình Supabase">
          <i data-lucide="settings" class="w-5 h-5"></i>
        </button>
      </div>
    </div>
  </header>

  <!-- FILTER BAR -->
  <section class="bg-white border-b border-slate-200 sticky top-16 z-20 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap items-center gap-3">
        <!-- Chọn Tháng -->
        <div class="flex items-center gap-2">
          <label class="text-xs font-semibold text-slate-500 uppercase">Tháng:</label>
          <select id="filterMonth" onchange="onFilterChange()" class="bg-slate-50 border border-slate-300 text-slate-800 text-sm rounded-lg focus:ring-emerald-600 focus:border-emerald-600 px-3 py-1.5 font-medium">
            <option value="">-- Đang tải tháng --</option>
          </select>
        </div>

        <!-- Chọn Sale -->
        <div class="flex items-center gap-2">
          <label class="text-xs font-semibold text-slate-500 uppercase">Nhân viên Sale:</label>
          <select id="filterSalesRep" onchange="onFilterChange()" class="bg-slate-50 border border-slate-300 text-slate-800 text-sm rounded-lg focus:ring-emerald-600 focus:border-emerald-600 px-3 py-1.5 font-medium">
            <option value="ALL">Tất cả 5 Sale (Team BC)</option>
          </select>
        </div>

        <!-- Lọc Brand -->
        <div class="flex items-center gap-2">
          <label class="text-xs font-semibold text-slate-500 uppercase">Nhãn hàng:</label>
          <select id="filterBrand" onchange="renderActiveTab()" class="bg-slate-50 border border-slate-300 text-slate-800 text-sm rounded-lg focus:ring-emerald-600 focus:border-emerald-600 px-3 py-1.5 font-medium">
            <option value="ALL">Tất cả Brand Carlsberg</option>
            <option value="Carlsberg">Carlsberg</option>
            <option value="1664 Blanc">1664 Blanc</option>
            <option value="Tuborg Ice">Tuborg Ice</option>
            <option value="Tuborg Green">Tuborg Green</option>
            <option value="Huda">Huda</option>
            <option value="Somersby">Somersby</option>
          </select>
        </div>
      </div>

      <button onclick="refreshAllData()" class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-600 hover:text-emerald-700 bg-slate-100 hover:bg-emerald-50 px-3 py-1.5 rounded-lg transition">
        <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i> Làm mới dữ liệu
      </button>
    </div>

    <!-- MAIN NAVIGATION TABS -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex space-x-6 overflow-x-auto border-t border-slate-100">
      <button id="tabBtn-reconcile" onclick="switchTab('reconcile')" class="py-3 text-sm whitespace-nowrap tab-active flex items-center gap-2">
        <i data-lucide="bar-chart-3" class="w-4 h-4"></i> 1. Đối Chiếu Sản Lượng & Lũy Kế
      </button>
      <button id="tabBtn-kv" onclick="switchTab('kv')" class="py-3 text-sm whitespace-nowrap tab-inactive flex items-center gap-2">
        <i data-lucide="store" class="w-4 h-4"></i> 2. Khách Hàng KiotViet
      </button>
      <button id="tabBtn-dms" onclick="switchTab('dms')" class="py-3 text-sm whitespace-nowrap tab-inactive flex items-center gap-2">
        <i data-lucide="smartphone" class="w-4 h-4"></i> 3. Khách Hàng DMS (Viet Bill)
      </button>
      <button id="tabBtn-custMatch" onclick="switchTab('custMatch')" class="py-3 text-sm whitespace-nowrap tab-inactive flex items-center gap-2">
        <i data-lucide="git-merge" class="w-4 h-4"></i> 4. Ghép & Đối Chiếu Khách Hàng
      </button>
      <button id="tabBtn-promo" onclick="switchTab('promo')" class="py-3 text-sm whitespace-nowrap tab-inactive flex items-center gap-2">
        <i data-lucide="gift" class="w-4 h-4"></i> 5. Hàng 0đ KV & Voucher DMS
      </button>
    </div>
  </section>

  <!-- MAIN CONTENT CONTAINER -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <!-- BANNER CẢNH BÁO MÃ SKU MỚI CHƯA PHÂN NHÓM -->
    <div id="unmappedAlert" class="hidden mb-5 bg-amber-50 border border-amber-300 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="flex items-start gap-3">
        <i data-lucide="alert-triangle" class="w-5 h-5 text-amber-600 mt-0.5 shrink-0"></i>
        <div>
          <h3 class="text-sm font-semibold text-amber-900">Phát hiện mã SKU mới chưa được gán nhóm sản phẩm!</h3>
          <p id="unmappedText" class="text-xs text-amber-800 mt-0.5"></p>
        </div>
      </div>
      <button onclick="openSkuModal()" class="shrink-0 bg-amber-600 hover:bg-amber-700 text-white text-xs font-semibold px-3.5 py-2 rounded-lg">
        Phân nhóm ngay
      </button>
    </div>

    <!-- ==================== TAB 1: ĐỐI CHIẾU SẢN LƯỢNG & LŨY KẾ ==================== -->
    <div id="view-reconcile" class="space-y-6">
      <!-- KPI Cards -->
      <div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
        <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
          <p class="text-xs font-medium text-slate-500">Bán KiotViet (Tính tiền)</p>
          <p id="kpi-kvPaid" class="text-2xl font-bold text-slate-900 mt-1">0</p>
          <p class="text-[11px] text-slate-400 mt-1">Gốc đối chiếu tháng chọn</p>
        </div>
        <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
          <p class="text-xs font-medium text-slate-500">Key DMS (Order)</p>
          <p id="kpi-dmsOrder" class="text-2xl font-bold text-emerald-700 mt-1">0</p>
          <p class="text-[11px] text-slate-400 mt-1">NPP Viet Bill (đã trừ Return)</p>
        </div>
        <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
          <p class="text-xs font-medium text-slate-500">Lệch Tháng Trước Chuyển Sang</p>
          <p id="kpi-prevDiff" class="text-2xl font-bold text-slate-700 mt-1">0</p>
          <p class="text-[11px] text-slate-400 mt-1">Lũy kế đến hết tháng T-1</p>
        </div>
        <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
          <p class="text-xs font-medium text-slate-500">Phát Sinh Tháng Này</p>
          <p id="kpi-monthDiff" class="text-2xl font-bold mt-1">0</p>
          <p class="text-[11px] text-slate-400 mt-1">= Key DMS - Bán KV</p>
        </div>
        <div class="bg-emerald-950 text-white p-4 rounded-xl shadow-sm col-span-2 lg:col-span-1">
          <p class="text-xs font-medium text-emerald-300">Tổng Lũy Kế Cuối Kỳ</p>
          <p id="kpi-totalDiff" class="text-2xl font-bold mt-1">0</p>
          <p id="kpi-totalLabel" class="text-[11px] text-emerald-300 mt-1">Cân bằng số liệu</p>
        </div>
      </div>

      <!-- Bảng Đối Chiếu SKU Chuẩn -->
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <h2 class="font-bold text-slate-800 text-base">Bảng Đối Chiếu Theo Nhóm SKU Chuẩn (Thùng / Két)</h2>
            <p class="text-xs text-slate-500">Số dương (+): Key DMS dư so với bán KV • Số âm (-): Còn thiếu key trên DMS</p>
          </div>
          <button onclick="openSkuModal()" class="text-xs font-medium text-emerald-700 hover:underline flex items-center gap-1">
            <i data-lucide="layers" class="w-3.5 h-3.5"></i> Xem bảng quy đổi mã SKU
          </button>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm text-left">
            <thead class="bg-slate-50 text-slate-600 font-semibold text-xs uppercase border-b border-slate-200">
              <tr>
                <th class="px-4 py-3">Nhãn Hàng</th>
                <th class="px-4 py-3">Sản Phẩm Chuẩn (Gộp mã)</th>
                <th class="px-4 py-3 text-right">Bán KV<br><span class="text-[10px] font-normal lowercase">(tính tiền)</span></th>
                <th class="px-4 py-3 text-right">Key DMS<br><span class="text-[10px] font-normal lowercase">(order)</span></th>
                <th class="px-4 py-3 text-right bg-slate-100/70">Lệch Tháng Trước<br><span class="text-[10px] font-normal lowercase">(tồn đầu kỳ)</span></th>
                <th class="px-4 py-3 text-right">Lệch Tháng Này<br><span class="text-[10px] font-normal lowercase">(dms - kv)</span></th>
                <th class="px-4 py-3 text-right bg-emerald-50/70 text-emerald-900">Tổng Lũy Kế<br><span class="text-[10px] font-normal lowercase">(cuối kỳ)</span></th>
                <th class="px-4 py-3 text-right text-amber-700">Hàng 0đ KV<br><span class="text-[10px] font-normal lowercase">(tặng kèm)</span></th>
              </tr>
            </thead>
            <tbody id="reconcileTableBody" class="divide-y divide-slate-100">
              <tr><td colspan="8" class="px-4 py-8 text-center text-slate-400">Chưa có dữ liệu. Hãy cấu hình Supabase và tải file Excel lên.</td></tr>
            </tbody>
            <tfoot id="reconcileTableFoot" class="bg-slate-100 font-bold text-slate-900 border-t-2 border-slate-300">
            </tfoot>
          </table>
        </div>
      </div>
    </div>

    <!-- ==================== TAB 2: KHÁCH HÀNG KIOTVIET ==================== -->
    <div id="view-kv" class="hidden space-y-4">
      <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="relative flex-1 max-w-md">
          <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-2.5"></i>
          <input type="text" id="searchKvCust" onkeyup="renderKvCustomersTab()" placeholder="Tìm tên quán, mã KH hoặc SĐT trên KiotViet..." class="w-full pl-9 pr-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-emerald-600 focus:border-emerald-600" />
        </div>
        <div class="text-xs text-slate-500">
          Bấm vào từng khách hàng để xổ chi tiết sản phẩm đã mua trong tháng & 3 tháng gần nhất
        </div>
      </div>
      <div id="kvCustomersList" class="space-y-2.5"></div>
    </div>

    <!-- ==================== TAB 3: KHÁCH HÀNG DMS ==================== -->
    <div id="view-dms" class="hidden space-y-4">
      <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="relative flex-1 max-w-md">
          <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-2.5"></i>
          <input type="text" id="searchDmsCust" onkeyup="renderDmsCustomersTab()" placeholder="Tìm tên Outlet hoặc OutletCode trên DMS..." class="w-full pl-9 pr-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-emerald-600 focus:border-emerald-600" />
        </div>
        <div class="text-xs text-slate-500">
          Chỉ hiển thị Outlet thuộc NPP Viet Bill (CD1084) • Bấm vào tên quán để xem chi tiết SKU đã key
        </div>
      </div>
      <div id="dmsCustomersList" class="space-y-2.5"></div>
    </div>

    <!-- ==================== TAB 4: GHÉP & ĐỐI CHIẾU KHÁCH HÀNG ==================== -->
    <div id="view-custMatch" class="hidden space-y-6">
      <!-- Khu vực 1: Bộ lọc thông minh gợi ý ghép cặp KV <-> DMS -->
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 pb-4 border-b border-slate-100">
          <div>
            <h2 class="font-bold text-slate-800 text-base flex items-center gap-2">
              <i data-lucide="sparkles" class="w-5 h-5 text-amber-500"></i> Ghép Cặp Khách Hàng KiotViet & DMS (Lưu vĩnh viễn)
            </h2>
            <p class="text-xs text-slate-500 mt-0.5">Hệ thống tự lọc theo cùng Sale phụ trách và chấm điểm giống tên. Sale xác nhận 1 lần, các tháng sau tự động đối chiếu.</p>
          </div>
          <div class="flex items-center gap-2">
            <button onclick="openManualLinkModal()" class="bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-semibold px-3.5 py-2 rounded-lg flex items-center gap-1.5">
              <i data-lucide="link" class="w-3.5 h-3.5"></i> Ghép thủ công 2 quán
            </button>
          </div>
        </div>

        <div id="suggestionsContainer" class="mt-4 space-y-2">
          <p class="text-sm text-slate-400 text-center py-4">Đang tải gợi ý ghép khách hàng...</p>
        </div>
      </div>

      <!-- Khu vực 2: Bảng Đối Chiếu Trực Quan Các Khách Hàng Đã Ghép (Xem được lịch sử 3 tháng) -->
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h2 class="font-bold text-slate-800 text-base">Đối Chiếu Trực Quan Khách Hàng Đã Ghép</h2>
            <p class="text-xs text-slate-500">Bấm vào một khách hàng để xem chi tiết từng sản phẩm và lịch sử 3 tháng gần nhất</p>
          </div>
          <div class="relative w-full sm:w-72">
            <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-2.5"></i>
            <input type="text" id="searchLinkedCust" onkeyup="renderLinkedCustomersComparison()" placeholder="Tìm khách hàng đã ghép..." class="w-full pl-9 pr-3 py-1.5 text-sm border border-slate-300 rounded-lg" />
          </div>
        </div>
        <div id="linkedComparisonList" class="divide-y divide-slate-200"></div>
      </div>
    </div>

    <!-- ==================== TAB 5: HÀNG 0Đ KIOTVIET & VOUCHER DMS ==================== -->
    <div id="view-promo" class="hidden grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Cột trái: Hàng 0đ KiotViet -->
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="px-5 py-4 bg-amber-50/70 border-b border-amber-200 flex items-center justify-between">
          <div>
            <h2 class="font-bold text-amber-950 text-base">Hàng Xuất 0đ Trên KiotViet</h2>
            <p class="text-xs text-amber-800">Tách riêng khỏi số bán đối chiếu • Hiển thị kèm ghi chú CTKM</p>
          </div>
          <span id="badge-kvFreeTotal" class="bg-amber-600 text-white text-xs font-bold px-2.5 py-1 rounded-full">0 két/thùng</span>
        </div>
        <div class="overflow-x-auto max-h-[550px]">
          <table class="w-full text-xs text-left">
            <thead class="bg-slate-50 text-slate-600 font-semibold uppercase border-b sticky top-0">
              <tr>
                <th class="px-3 py-2.5">Ngày / HĐ</th>
                <th class="px-3 py-2.5">Khách Hàng / Sale</th>
                <th class="px-3 py-2.5">Sản Phẩm</th>
                <th class="px-3 py-2.5 text-right">SL</th>
                <th class="px-3 py-2.5">Ghi Chú</th>
              </tr>
            </thead>
            <tbody id="kvFreeTableBody" class="divide-y divide-slate-100"></tbody>
          </table>
        </div>
      </div>

      <!-- Cột phải: Suất Voucher trả NPP trên DMS -->
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="px-5 py-4 bg-emerald-50/70 border-b border-emerald-200 flex items-center justify-between">
          <div>
            <h2 class="font-bold text-emerald-950 text-base">Suất Voucher Giảm Giá Trên DMS</h2>
            <p class="text-xs text-emerald-800">Tổng hợp phiếu giảm giá trả lại cho NPP Viet Bill</p>
          </div>
          <span id="badge-dmsVoucherTotal" class="bg-emerald-700 text-white text-xs font-bold px-2.5 py-1 rounded-full">0 suất</span>
        </div>
        <div class="p-4 border-b border-slate-100 bg-slate-50/50" id="dmsVoucherSummaryCards"></div>
        <div class="overflow-x-auto max-h-[450px]">
          <table class="w-full text-xs text-left">
            <thead class="bg-slate-50 text-slate-600 font-semibold uppercase border-b sticky top-0">
              <tr>
                <th class="px-3 py-2.5">Ngày / Đơn</th>
                <th class="px-3 py-2.5">Outlet / Sale</th>
                <th class="px-3 py-2.5">Loại Phiếu Giảm Giá</th>
                <th class="px-3 py-2.5 text-right">SL</th>
              </tr>
            </thead>
            <tbody id="dmsVoucherTableBody" class="divide-y divide-slate-100"></tbody>
          </table>
        </div>
      </div>
    </div>

  </main>

  <!-- ==================== MODAL 1: CẤU HÌNH SUPABASE ==================== -->
  <div id="configModal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl space-y-4">
      <div class="flex items-center justify-between border-b pb-3">
        <h3 class="font-bold text-slate-800 text-lg flex items-center gap-2">
          <i data-lucide="database" class="w-5 h-5 text-emerald-700"></i> Kết Nối Supabase Cloud
        </h3>
        <button onclick="closeModal('configModal')" class="text-slate-400 hover:text-slate-600"><i data-lucide="x" class="w-5 h-5"></i></button>
      </div>
      <p class="text-xs text-slate-500">Lấy thông tin tại <b>Supabase Dashboard &rarr; Project Settings &rarr; API</b>. Thông tin được lưu an toàn trên trình duyệt của anh.</p>
      <div class="space-y-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Project URL</label>
          <input type="text" id="cfgSupabaseUrl" placeholder="https://xxxxxxxxxxxx.supabase.co" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Anon Public Key</label>
          <input type="password" id="cfgSupabaseKey" placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg" />
        </div>
      </div>
      <div class="flex justify-end gap-2 pt-2">
        <button onclick="closeModal('configModal')" class="px-4 py-2 text-sm text-slate-600 hover:bg-slate-100 rounded-lg">Đóng</button>
