    function renderLinkedCustomersComparison() {
      const kw = document.getElementById('searchLinkedCust').value.toLowerCase().trim();
      const kvMap = new Map(state.kvCustomers.map(c => [c.kv_customer_code, c]));
      const dmsMap = new Map(state.dmsOutlets.map(o => [o.dms_outlet_code, o]));
      const skuToGroup = new Map();
      state.skuMappings.forEach(m => {
        const grp = state.productGroups.find(g => g.id === m.product_group_id);
        if (grp) skuToGroup.set(`${m.source_system}_${m.raw_code}`, grp.group_name);
      });

      const container = document.getElementById('linkedComparisonList');
      const filteredLinks = state.customerLinks.filter(l => {
        const kv = kvMap.get(l.kv_customer_code) || {};
        const dms = dmsMap.get(l.dms_outlet_code) || {};
        return !kw || (kv.kv_customer_name || '').toLowerCase().includes(kw) || (dms.dms_outlet_name || '').toLowerCase().includes(kw);
      });

      if (filteredLinks.length === 0) {
        container.innerHTML = `<div class="p-8 text-center text-sm text-slate-400">Chưa có cặp khách hàng nào được ghép. Hãy xác nhận gợi ý ở khung phía trên.</div>`;
        return;
      }

      container.innerHTML = filteredLinks.map(l => {
        const kv = kvMap.get(l.kv_customer_code) || { kv_customer_name: l.kv_customer_code };
        const dms = dmsMap.get(l.dms_outlet_code) || { dms_outlet_name: l.dms_outlet_code };

        // Tính tổng 3 tháng gần nhất theo từng nhóm SKU chuẩn cho khách hàng này
        const skuMatrix = {};
        state.kvLines3M.filter(x => x.kv_customer_code === l.kv_customer_code && !x.is_free_gift).forEach(x => {
          const gName = skuToGroup.get(`KIOTVIET_${x.raw_product_code}`) || x.raw_product_name;
          if (!skuMatrix[gName]) skuMatrix[gName] = { kv: 0, dms: 0 };
          skuMatrix[gName].kv += Number(x.quantity);
        });
        state.dmsLines3M.filter(x => x.dms_outlet_code === l.dms_outlet_code && x.order_type === 'Order' && !x.is_posm_voucher).forEach(x => {
          const gName = skuToGroup.get(`DMS_${x.raw_product_code}`) || x.raw_product_name;
          if (!skuMatrix[gName]) skuMatrix[gName] = { kv: 0, dms: 0 };
          skuMatrix[gName].dms += Number(x.quantity);
        });

        let sumKv3M = 0, sumDms3M = 0;
        Object.values(skuMatrix).forEach(v => { sumKv3M += v.kv; sumDms3M += v.dms; });
        const diff3M = sumDms3M - sumKv3M;

        return `
          <div class="p-4 hover:bg-slate-50/60 transition">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 cursor-pointer" onclick="toggleAccordion('link-det-${l.id}')">
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="font-bold text-slate-900 text-sm">${kv.kv_customer_name}</span>
                  <span class="text-xs text-slate-400">&harr;</span>
                  <span class="font-semibold text-emerald-800 text-sm">${dms.dms_outlet_name}</span>
                </div>
                <p class="text-[11px] text-slate-400 mt-0.5">KV: ${l.kv_customer_code} • DMS: ${l.dms_outlet_code}</p>
              </div>
              <div class="flex items-center gap-4 text-xs">
                <div>KV (3T): <b>${fmtNum(sumKv3M)}</b></div>
                <div>DMS (3T): <b class="text-emerald-700">${fmtNum(sumDms3M)}</b></div>
                <div class="px-2 py-1 rounded font-bold ${diff3M === 0 ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'}">
                  Lệch: ${fmtDiff(diff3M)}
                </div>
                <button onclick="event.stopPropagation(); unlinkCustomer('${l.id}')" class="text-slate-400 hover:text-rose-600 p-1" title="Hủy ghép">
                  <i data-lucide="unlink" class="w-3.5 h-3.5"></i>
                </button>
              </div>
            </div>

            <div id="link-det-${l.id}" class="hidden mt-3 pt-3 border-t border-slate-200">
              <table class="w-full text-xs text-left bg-white rounded-lg border">
                <thead class="bg-slate-100 text-slate-600 font-semibold">
                  <tr>
                    <th class="px-3 py-2">Nhóm Sản Phẩm (3 Tháng Qua)</th>
                    <th class="px-3 py-2 text-right">Bán KiotViet</th>
                    <th class="px-3 py-2 text-right">Key DMS</th>
                    <th class="px-3 py-2 text-right">Chênh Lệch</th>
                  </tr>
                </thead>
                <tbody class="divide-y">
                  ${Object.entries(skuMatrix).map(([gName, val]) => `
                    <tr>
                      <td class="px-3 py-2 font-medium">${gName}</td>
                      <td class="px-3 py-2 text-right">${fmtNum(val.kv)}</td>
                      <td class="px-3 py-2 text-right text-emerald-700">${fmtNum(val.dms)}</td>
                      <td class="px-3 py-2 text-right font-bold ${diffColor(val.dms - val.kv)}">${fmtDiff(val.dms - val.kv)}</td>
                    </tr>
                  `).join('')}
                </tbody>
              </table>
            </div>
          </div>
        `;
      }).join('');
    }

