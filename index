    function renderDmsCustomersTab() {
      const kw = document.getElementById('searchDmsCust').value.toLowerCase().trim();
      const outMap = new Map(state.dmsOutlets.map(o => [o.dms_outlet_code, o]));
      const repMap = new Map(state.salesReps.map(r => [r.id, r.full_name]));

      const agg = new Map();
      state.dmsLinesMonth.filter(l => l.order_type === 'Order' && !l.is_posm_voucher).forEach(line => {
        if (!agg.has(line.dms_outlet_code)) {
          agg.set(line.dms_outlet_code, { qty: 0, rev: 0 });
        }
        const entry = agg.get(line.dms_outlet_code);
        entry.qty += Number(line.quantity);
        entry.rev += Number(line.revenue);
      });

      const list = Array.from(agg.entries()).filter(([code]) => {
        const o = outMap.get(code) || {};
        return !kw || code.toLowerCase().includes(kw) || (o.dms_outlet_name || '').toLowerCase().includes(kw);
      }).sort((a, b) => b[1].qty - a[1].qty);

      const container = document.getElementById('dmsCustomersList');
      if (list.length === 0) {
        container.innerHTML = `<div class="bg-white p-8 rounded-xl border text-center text-slate-400 text-sm">Không tìm thấy Outlet DMS phát sinh trong tháng này.</div>`;
        return;
      }

      container.innerHTML = list.map(([code, data]) => {
        const o = outMap.get(code) || { dms_outlet_name: code };
        const repName = repMap.get(o.sales_rep_id) || 'Chưa gán sale';
        const hist3M = state.dmsLines3M.filter(l => l.dms_outlet_code === code && l.order_type === 'Order' && !l.is_posm_voucher);
        const histByMonth = {};
        hist3M.forEach(h => {
          const m = h.order_month.slice(0, 7);
          if (!histByMonth[m]) histByMonth[m] = {};
          histByMonth[m][h.raw_product_name] = (histByMonth[m][h.raw_product_name] || 0) + Number(h.quantity);
        });

        return `
          <div class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden">
            <button onclick="toggleAccordion('dms-det-${code}')" class="w-full px-5 py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-left hover:bg-slate-50 transition">
              <div>
                <div class="flex items-center gap-2">
                  <span class="text-xs font-mono bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded">${code}</span>
                  <span class="font-bold text-slate-800 text-sm">${o.dms_outlet_name}</span>
                </div>
                <p class="text-xs text-slate-500 mt-1">Sale: <b>${repName}</b> ${o.channel ? `• Kênh: ${o.channel}` : ''}</p>
              </div>
              <div class="flex items-center gap-4">
                <div class="text-right">
                  <span class="text-xs text-slate-500 block">Đã Key DMS</span>
                  <span class="font-bold text-emerald-700 text-sm">${fmtNum(data.qty)} pack</span>
                </div>
                <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400"></i>
              </div>
            </button>

            <div id="dms-det-${code}" class="hidden border-t border-slate-100 bg-slate-50/70 p-4 space-y-3">
              <p class="text-xs font-bold text-slate-700 uppercase">Lịch sử key 3 tháng gần nhất trên DMS:</p>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                ${Object.entries(histByMonth).sort().reverse().map(([m, prods]) => `
                  <div class="bg-white p-3 rounded-lg border border-slate-200 text-xs">
                    <div class="font-bold text-emerald-800 border-b pb-1 mb-1.5">Tháng ${m}</div>
                    <ul class="space-y-1">
                      ${Object.entries(prods).map(([pName, q]) => `
                        <li class="flex justify-between gap-2">
                          <span class="text-slate-600 truncate">${pName}</span>
                          <span class="font-semibold text-slate-900 shrink-0">${fmtNum(q)}</span>
