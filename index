    async function confirmCustomerLink(kvCode, dmsCode, score, method) {
      if (!supabaseClient) return;
      const { error } = await supabaseClient.from('customer_links').upsert({
        kv_customer_code: kvCode,
        dms_outlet_code: dmsCode,
        match_score: score,
        match_method: method
      });
      if (error) return alert('Lỗi khi ghép khách hàng: ' + error.message);
      await onFilterChange();
    }

    async function unlinkCustomer(linkId) {
      if (!confirm('Hủy liên kết cặp khách hàng này?')) return;
      await supabaseClient.from('customer_links').delete().eq('id', linkId);
      await onFilterChange();
    }

    function openManualLinkModal() {
